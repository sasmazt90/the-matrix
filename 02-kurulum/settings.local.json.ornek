{
  "$schema": "https://claude.ai/schemas/settings.json",
  "_comment": "Local settings — .gitignore'a ekleyin. Production-grade permission örneği.",

  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(vitest:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tsc:*)",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:github.com)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(vercel:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Edit(.env*)",
      "Edit(.claude/settings.json)",
      "Edit(package.json)",
      "Write(.env*)"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(*--force:*)",
      "Bash(*--no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(*prod*)",
      "Bash(*production*)",
      "Edit(.env.production)",
      "Edit(.env.production.local)",
      "Write(.env.production)",
      "Bash(psql:*-h prod*)",
      "Bash(redis-cli:*-h prod*)"
    ]
  },

  "model": "claude-sonnet-4-6",

  "_advanced_examples": {
    "_comment": "Aşağıdakiler de eklenebilir, kullanmıyorsan kaldır",

    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "./scripts/check-no-secrets.sh",
              "blocking": true
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit",
          "hooks": [
            {
              "type": "command",
              "command": "prettier --write \"$FILE\" 2>/dev/null"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "./scripts/notify-stop.sh"
            }
          ]
        }
      ]
    }
  }
}
